<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\warp.core\warp.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
  </ItemGroup>

  <Target Name="GenerateSwagger" AfterTargets="Build">
    <PropertyGroup>
      <SwaggerOutputFile>$({ProjectDir})$(AssemblyName).yml</SwaggerOutputFile>
    </PropertyGroup>
    <Exec Command="dotnet swagger tofile --yaml --output $(SwaggerOutputFile) $(OutputPath)$(AssemblyName).dll v1" />
  </Target>

</Project>
