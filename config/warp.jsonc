{
  "$include:datacontext": "shared/${DATACONTEXT_IMPL}-datacontext.jsonc",
  "$include:opentelemetry": "shared/opentelemetry.jsonc",
  
  "ReverseProxy": {
    
    "$include:yarp-clusters": "shared/clusters.jsonc",
    
    "Routes": {
      "admin": {
        "ClusterId": "admin_cluster",
        "Match": {
          "Path": "/admin/{**remainder}"
        },
        "Metadata": {
          "Preprocess": "OpenTelemetryStart,AdminJwtValidator,RateLimiter,AdminPermissionsChecker",
          "Postprocess": "OpenTelemetryEnd"
        }
      },
      "developer": {
        "ClusterId": "developer_api_cluster",
        "Match": {
          "Path": "/developer/{**remainder}"
        },
        "Metadata": {
          "Preprocess": "OpenTelemetryStart,JwtValidator,RateLimiter,DevPermissionsChecker",
          "Predispatch": "DevOpenApiValidator",
          "Postprocess": "OpenTelemetryEnd"
        }
      },

      "memoryalpha_pro": {
        "ClusterId": "memoryalpha_cluster",
        "Timeout": "00:05:00",
        "Match": {
          "Path": "/api/pro/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "PathRemovePrefix": "/pro" }
        ],
        "Metadata": {
          
          "Preprocess": "OpenTelemetryStart,ApiKeyOrJwtKeyValidator,ProRateLimiter,ProQuotaChecker",
          "Predispatch": "MemoryAlphaOpenApiValidator",
          "Postprocess": "OpenTelemetryEnd"
        }
      },

      "memoryalpha_pro_async": {
        "ClusterId": "memoryalpha_cluster",
        "Timeout": "00:05:00",
        "Match": {
          "Path": "async/api/pro/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/async" },
          { "PathRemovePrefix": "/api" },
          { "PathRemovePrefix": "/pro" }
        ],
        "Metadata": {
          "Preprocess": "OpenTelemetryStart,ApiKeyOrJwtKeyValidator,ProRateLimiter,ProQuotaChecker",
          "Predispatch": "MemoryAlphaOpenApiValidator,RedisAsyncApiHandler",
          "Postprocess": "OpenTelemetryEnd"
        }

      },

      "memoryalpha_basic": {
        "ClusterId": "memoryalpha_cluster",
        "Match": {
          "Path": "/api/basic/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "PathRemovePrefix": "/basic" }
        ],
        "Metadata": {
          "Preprocess": "OpenTelemetryStart,ApiKeyOrJwtKeyValidator,BasicRateLimiter,BasicQuotaChecker",
          "Predispatch": "MemoryAlphaOpenApiValidator",
          "Postprocess": "OpenTelemetryEnd"
        }
      }
    }
  },
  "PipelineComponents": [
    {
      "Name": "OpenTelemetryStart",
      "Type": "Warp.Dilithium.Middleware.OpenTelemetryStart, warp.dilithium",
      "Options": {
        "tagHeaders": ["x-api-key", "x-request-id"]
      }
    },
    {
      "Name": "ApiKeyOrJwtKeyValidator",
      "Type": "Warp.Dilithium.Middleware.OrMiddleware, warp.dilithium",
      "Options": {
        "Middleware2": {
          "Name": "JwtValidator",
          "Type": "Warp.Dilithium.Middleware.JwtValidator, warp.dilithium",
          "Options": {
            "JwksUri": "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com"
          }
        },
        "Middleware1":     {
          "Name": "ApiKeyValidator",
          "Type": "Warp.Dilithium.Middleware.ApiKeyValidator, warp.dilithium"
        }
      }
    },
    {
      "Name": "AdminJwtValidator",
      "Type": "Warp.Dilithium.Middleware.JwtValidator, warp.dilithium",
      "Options": {
        "JwksUri": "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com",
        "ValidEmails": [
          "ani@anionline.me"
        ]
      }
    },
    {
      "Name": "JwtValidator",
      "Type": "Warp.Dilithium.Middleware.JwtValidator, warp.dilithium",
      "Options": {
        "JwksUri": "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com"
      }
    },
    {
      "Name": "RateLimiter",
      "Type": "Warp.Dilithium.Middleware.RateLimiter, warp.dilithium",
      "Options": {
        "RateLimitHz": 2.0
      }
    },
    {
      "Name": "ApiKeyRateLimiter",
      "Type": "Warp.Dilithium.Middleware.RateLimiter, warp.dilithium",
      "options": {
        "RateLimitHz": 2.0
      }
    },
    {
      "Name": "OpenTelemetryEnd",
      "Type": "Warp.Dilithium.Middleware.OpenTelemetryEnd, warp.dilithium"
    },
    {
      "Name": "DevPermissionsChecker",
      "Type": "Warp.Dilithium.Middleware.PermissionsChecker, warp.dilithium",
      "Options": {
        "RequiredPermissions": [ "developer" ],       
        "CreateUserIfNotFound": true,
        "DefaultPermissions": [ "developer", "user" ]
      }
    },
    {
      "Name": "AdminPermissionsChecker",
      "Type": "Warp.Dilithium.Middleware.PermissionsChecker, warp.dilithium",
      "Options": {
        "RequiredPermissions": [ "admin" ]
      }
    },
    {
      "Name": "DevOpenApiValidator",
      "Type": "Warp.Dilithium.Middleware.OpenApiValidator, warp.dilithium",
      "Options": {
        "SpecFile": "warp.apis.developer.yml"
      }
    },
    {
      "Name": "AdminOpenApiValidator",
      "Type": "Warp.Dilithium.Middleware.OpenApiValidator, warp.dilithium",
      "Options": {
        "SpecFile": "warp.apis.admin.yml"
      }
    },
    {
      "Name": "MemoryAlphaOpenApiValidator",
      "Type": "Warp.Dilithium.Middleware.OpenApiValidator, warp.dilithium",
      "Options": {
        "SpecFile": "spec/memoryalpha-rag-api-spec.json",
        "ApplyOn": ["Sync", "AsyncSubmit"]
      }
    },
    {
      "Name": "ProRateLimiter",
      "Type": "Warp.Dilithium.Middleware.RateLimiter, warp.dilithium",
      "Options": {
        "RateLimitHz": 10.0
      }
    },
    {
      "Name": "BasicRateLimiter",
      "Type": "Warp.Dilithium.Middleware.RateLimiter, warp.dilithium",
      "Options": {
        "RateLimitHz": 2.0
      }
    },
    {
      "Name": "BasicQuotaChecker",
      "Type": "Warp.Dilithium.Middleware.QuotaChecker, warp.dilithium",
      "Options": {
        "QuotaName": "basic_quota",
        "QuotaUsage": 1.0,
        "DefaultQuota": 10.0
      }
    },
    {
      "Name": "ProQuotaChecker",
      "Type": "Warp.Dilithium.Middleware.QuotaChecker, warp.dilithium",
      "Options": {
        "QuotaName": "pro_quota",
        "QuotaUsage": 1.0,
        "QuotaType": "postpaid",
        "CreateQuotaIfNotFound": true
      }
    },
    {
      "Name": "RedisAsyncApiHandler",
      "Type": "Warp.Dilithium.Middleware.RedisAsyncApiHandler, warp.dilithium",
      "Options": {
        "CreateUserIfNotFound": true,
        "DefaultPermissions": [ "developer", "user" ],
        "ConnectionString": "redis:6379,defaultDatabase=0",
        "DatabaseIndex": 0,
        "Channel": "memoryalpha",
        "Input": {
          "top_k": {
            "From": { "Query": "top_k" },
            "Required": false,
            "Default": "5"
          },
          "x-file-blob": {
            "From": { "Body": "file" },
            "Required": true,
            "Transform": {
              "Type": "Warp.Dilithium.Transforms.VolumeBlobTransform, warp.dilithium",
              "Options": {
                "VolumePath": "/uploads"
              }
            }
          }
        }
      }
    }
  ],

  "Kestrel": {
    "Endpoints": {
      "Public": {
        "Url": "http://*:5000"
      }
    }
  }
}