# Committed template for the generated, git-ignored docker-compose.worktree.yml.
#
# .devcontainer/initializeCommand.sh regenerates docker-compose.worktree.yml on
# every container init:
#   - In a git worktree checkout it replaces the volumes below with an
#     identity-path bind mount of the main repo's gitdir, so the worktree's
#     absolute `gitdir:` pointer resolves inside the container and git works.
#   - In a plain clone this file is copied verbatim as a no-op override
#     (appending nothing to the warp service).
#
# Pattern: Worktree-Aware Devcontainers via Host-Generated Compose Override.
services:
  warp:
    volumes: []
