<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local packages first -->
    <add key="LocalYarpPackages" value="/usr/local/src/yarp/packages" />
    <!-- Official NuGet -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="LocalYarpPackages">
      <!-- Only Yarp.* packages should come from local -->
      <package pattern="Yarp.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <!-- Everything else comes from NuGet -->
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Important: force lowest priority fallback -->
</configuration>