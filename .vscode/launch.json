{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Warp",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp/bin/Debug/net9.0/warp.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://0.0.0.0:5000",
                "FIRESTORE_EMULATOR_HOST": "firestore:8080"
            }
        },
        {
            "name": "DevApi",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp.apis.developer/bin/Debug/net9.0/warp.apis.developer.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://127.0.0.1:5002",
                "FIRESTORE_EMULATOR_HOST": "firestore:8080"
            }
        },
        {
            "name": "AdminApi",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp.apis.admin/bin/Debug/net9.0/warp.apis.admin.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://127.0.0.1:5003",
                "FIRESTORE_EMULATOR_HOST": "firestore:8080"
            }
        },
        {
            "name": "Plasma",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp.plasma/bin/Debug/net9.0/warp.plasma.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "FIRESTORE_EMULATOR_HOST": "firestore:8080"
            }
        },
        
        {
            "name": "Warp (simple)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp/bin/Debug/net9.0/warp.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "MEMORYALPHA_RAG_API_ADDR": "http://memoryalpha-rag-api:8000",
                "WARP_CONFIG_BASE_DIR": "./examples/simple" // This is all we need to configure
                // The rest of the configuration is fully config driven via warp.yml
            }
        },

        {
            "name": "DevApi (apikeys)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp.apis.developer/bin/Debug/net9.0/warp.apis.developer.dll",
            "env": {
                "WARP_CONFIG_BASE_DIR": "./examples/apikeys"
            },
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Warp (apikeys)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp/bin/Debug/net9.0/warp.dll",
            "cwd": "${workspaceFolder}",
            "env": {
                "MEMORYALPHA_RAG_API_ADDR": "http://memoryalpha-rag-api:8000",
                "WARP_CONFIG_BASE_DIR": "./examples/apikeys" // This is all we need to configure
                // The rest of the configuration is fully config driven via warp.yml
            }
        },

        {
            "name": "DevApi (quotas)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp.apis.developer/bin/Debug/net9.0/warp.apis.developer.dll",
            "justMyCode": false,
            "env": {
                "WARP_CONFIG_BASE_DIR": "./examples/quotas"
            },
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "AdminApi (quotas)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp.apis.admin/bin/Debug/net9.0/warp.apis.admin.dll",
            "justMyCode": false,
            "env": {
                "WARP_CONFIG_BASE_DIR": "./examples/quotas"
            },
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Warp (quotas)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp/bin/Debug/net9.0/warp.dll",
            "justMyCode": false,
            "env": {
                "MEMORYALPHA_RAG_API_ADDR": "http://memoryalpha-rag-api:8000",
                "WARP_CONFIG_BASE_DIR": "./examples/quotas" // This is all we need to configure
                // The rest of the configuration is fully config driven via warp.yml
            }
        },

    ],
    "compounds": [
        {
            "name": "Warp API Gateway",
            "configurations": ["Warp", "DevApi", "AdminApi", "Plasma"]            
        },
        {
            "name": "Warp Simple Example",
            "configurations": ["Warp (simple)"]
        },
        {
            "name": "Warp ApiKeys Example",
            "configurations": ["Warp (apikeys)", "DevApi (apikeys)"]
        },
        {
            "name": "Warp Quotas Example",
            "configurations": ["Warp (quotas)", "DevApi (quotas)", "AdminApi (quotas)"]
        }
    ]
}