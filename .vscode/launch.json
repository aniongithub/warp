{
    "version": "0.2.0",
    "configurations": [        
        {
            "name": "Warp (simple)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dotnet",
            "program": "${workspaceFolder}/warp/bin/Debug/net9.0/warp.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "MEMORYALPHA_RAG_API_ADDR": "http://memoryalpha-rag-api:8000",
                "WARP_CONFIG_BASE_DIR": "./examples/simple" // This is all we need to configure
                // The rest of the configuration is fully config driven via warp.yml
            },
            "presentation": {
                "hidden": true
            }   
        },

